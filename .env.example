# Copy to `.env.local` for local overrides (never commit real keys).
# On Vercel: Project → Settings → Environment Variables → same name.

# Google Maps Platform key (Places + optional Photorealistic 3D tiles).
# Restrict by HTTP referrer + API in Google Cloud. Set billing budgets/quotas.
# Used by the client (VITE_) and by /api/places-nearby if no key is sent.
VITE_GOOGLE_MAPS_API_KEY=
# Optional server-only alias (Vercel): same key without exposing a second secret
# GOOGLE_MAPS_API_KEY=