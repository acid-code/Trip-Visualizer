# Copy to `.env.local` for local overrides (never commit real keys).
# On Vercel: Project → Settings → Environment Variables.

# Server-only LocationIQ token for text → pin (/api/geocode).
# Free plan: 5,000 requests/day, 2/second. Do not expose this in the browser.
# https://locationiq.com — attribution "Search by LocationIQ.com" is shown in the app.
LOCATIONIQ_API_KEY=

# Server-only Google Maps Platform key (Places Nearby / card details / Photos via /api/*).
# Do NOT use the VITE_ prefix — that embeds the value in the browser bundle.
# Enable "Places API (New)" on the key. Restrict by HTTP referrer (and API) in Google Cloud.
# Restrict by HTTP referrer (and API) in Google Cloud. Set billing budgets/quotas.
GOOGLE_MAPS_API_KEY=

# Optional: Gemini for Day Coach (/api/ai-coach). Without it, grounded local suggestions are used.
GEMINI_API_KEY=
# Optional primary model (default cascade starts at gemini-3.5-flash-lite ~500 RPD).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: paste a key in the app Data panel for photoreal 3D Map Tiles
# (those requests must run in the browser) or to override the server key.

# Google Drive Excel sync (browser OAuth — must use VITE_ prefix).
# Create an OAuth 2.0 Web client in Google Cloud, enable Google Drive API,
# and add your app origins (e.g. http://localhost:5173 and your Vercel URL)
# under Authorized JavaScript origins. Scope used: drive.file.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Couple sharing (Firebase Auth Google + Firestore). Free Spark tier is enough for two people.
# Firebase Console → Project settings → Your apps → Web app config.
# Enable Authentication → Google, and create a Firestore database.
# Deploy firestore.rules from the repo. Add Vercel/local origins under Auth authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
